# Copy to .env next to the compose files. Clients send the key as "Authorization: Bearer <key>".
# A long random value, e.g. `openssl rand -hex 32`; compose refuses to start while it is empty.
CALLBUS_API_KEY=
# CALLBUS_VERSION=latest
# CALLBUS_PORT=8765
# Share of GPU memory vLLM may take (0.2 leaves room for other services on a shared GPU).
# VLLM_GPU_MEMORY_UTILIZATION=0.9
# compose.bundle.yaml only: 0 serves the backbone in bf16 instead of FP8.
# CALLBUS_FP8=1
